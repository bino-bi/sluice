# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Release Dockerfile consumed by goreleaser. The binary is built outside
# the container (by goreleaser-cross) and copied in — no builder stage
# here. Image labels are supplied by goreleaser via --label flags.
#
# For a local-build image (one-shot `docker build .`), use the root
# Dockerfile, which carries its own golang:1.25-bookworm builder stage.

# debian13 (trixie, glibc 2.41 / GCC 14 libstdc++), not debian12. goreleaser
# builds these binaries inside goreleaser-cross, which is Ubuntu noble — they
# require GLIBC_2.38 and GLIBCXX_3.4.32, and bookworm only ships glibc 2.36
# with a GCC-12 libstdc++, so every command failed at the dynamic linker.
# The root Dockerfile stays on debian12: it builds with a bookworm toolchain,
# so its binary has a matching glibc floor.
FROM gcr.io/distroless/cc-debian13:nonroot

ARG TARGETARCH

COPY sluice /usr/local/bin/sluice
# Pre-seeded loadable DuckDB extensions (fetched by the release workflow
# via scripts/fetch-duckdb-extensions.sh, shipped through goreleaser
# extra_files) so datasource attach never downloads at runtime. DuckDB
# resolves ~/.duckdb/extensions via $HOME (/home/nonroot).
COPY --chown=65532:65532 third_party/duckdb-extensions/${TARGETARCH} /home/nonroot/.duckdb/extensions

USER nonroot:nonroot
WORKDIR /var/lib/sluice

EXPOSE 8080 8081 9090

ENTRYPOINT ["/usr/local/bin/sluice"]
CMD ["serve"]
